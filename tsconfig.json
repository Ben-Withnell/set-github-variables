{
    "compilerOptions": {
        "allowJs": true,
        "target": "ES2023",
        "module": "nodenext",
        "lib": ["ES2023"],
        "outDir": "dist",
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true
    },
    "include": ["src/**/*.js"],
    "exclude": ["node_modules"]
}
